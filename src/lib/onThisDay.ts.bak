/**
 * Get "On This Day" events for a given date.
 */
export function getOnThisDay(date: Date): OnThisDayEvent[] {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  const key = `${month}-${day}`;
  return EVENTS[key] || [];
}
